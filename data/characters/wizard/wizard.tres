[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://data/character_data.gd" id="1_character"]
[ext_resource type="Script" path="res://data/skill_data.gd" id="2_skill"]
[ext_resource type="Script" path="res://data/weapon_data.gd" id="3_weapon"]
[ext_resource type="Resource" path="res://data/characters/wizard/mana_shield.tres" id="4_shield"]
[ext_resource type="Resource" path="res://data/characters/wizard/flow.tres" id="5_flow"]
[ext_resource type="Resource" path="res://data/weapons/magic_bolt.tres" id="6_bolt"]
[ext_resource type="Resource" path="res://data/weapons/meteor.tres" id="7_meteor"]

[resource]
script = ExtResource("1_character")
id = &"wizard"
display_name = "Волшебник"
anim_idle = "wizzard_m_idle_anim"
anim_run = "wizzard_m_run_anim"
max_hp = 100.0
move_speed = 85.0
starting_weapon = ExtResource("6_bolt")
class_weapons = Array[ExtResource("3_weapon")]([ExtResource("6_bolt"), ExtResource("7_meteor")])
skills = Array[ExtResource("2_skill")]([ExtResource("4_shield"), ExtResource("5_flow")])
