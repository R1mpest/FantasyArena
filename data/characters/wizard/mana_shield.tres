[gd_resource type="Resource" script_class="SkillData" format=3]

[ext_resource type="Script" path="res://data/skill_data.gd" id="1_data"]
[ext_resource type="Texture2D" path="res://assets/sprites/kyrise/shield_03c.png" id="2_icon"]

[resource]
script = ExtResource("1_data")
id = &"mana_shield"
title = "Мана-щит"
description = "Щит поглощает урон и восстанавливается без попаданий"
icon = ExtResource("2_icon")
perk = &"mana_shield"
max_level = 3
weight = 1.0
level_params = Array[Dictionary]([{"capacity": 15.0, "restore": 6.0, "knockback": false, "text": "Щит на 15 урона, восстанавливается через 6 с без попаданий"}, {"capacity": 22.0, "restore": 6.0, "knockback": false, "text": "Щит на 22 урона"}, {"capacity": 30.0, "restore": 6.0, "knockback": true, "text": "Щит на 30 урона; при разрушении отбрасывает врагов вокруг"}])
