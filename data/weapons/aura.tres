levels = Array[Dictionary]([{"damage": 8.0, "radius": 42.0, "tick": 0.5, "slow": 0.0, "text": "Радиус 42, 8 урона раз в 0,5 с"}, {"radius": 48.3, "text": "+15% радиуса"}, {"damage": 10.4, "text": "+30% урона"}, {"radius": 55.5, "tick": 0.425, "text": "+15% радиуса, удары на 15% чаще"}, {"slow": 0.25, "text": "Враги внутри замедлены на 25%"}])
