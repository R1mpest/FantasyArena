uses_quiver = false
levels = Array[Dictionary]([{"damage": 14.0, "fire_interval": 0.7, "projectile_count": 1.0, "pierce": 0.0, "resonance_every": 0.0, "resonance_radius": 0.0, "text": "1 снаряд, 14 урона, раз в 0,7 с"}, {"projectile_count": 2.0, "text": "+1 снаряд в залпе"}, {"damage": 17.5, "pierce": 1.0, "text": "+25% урона, снаряд пробивает 1 врага"}, {"projectile_count": 3.0, "fire_interval": 0.6, "text": "+1 снаряд, перезарядка −15%"}, {"damage": 21.9, "resonance_every": 4.0, "resonance_radius": 32.0, "text": "Каждый 4-й снаряд взрывается при попадании (радиус 32), +25% урона"}])
